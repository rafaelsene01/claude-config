{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "acceptEditsPaths": ["src/**", "tests/**", "docs/**"],
    "deny": [
      "Bash(git commit)",
      "Bash(git commit:*)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git push *)",
      "PowerShell(git commit)",
      "PowerShell(git commit:*)",
      "PowerShell(git commit *)",
      "PowerShell(git push)",
      "PowerShell(git push:*)",
      "PowerShell(git push *)",
      "Bash(npm install:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)"
    ]
  },
  "mcpServers": {
    "context7": { "command": "npx", "args": ["-y", "@context7/mcp"] }
  },
  "mcpServersDenyAll": true
}
